{
  "name": "contabilidad/erp-backend",
  "type": "project",
  "description": "ERP Contable y Financiero Multi-Tenant (Clean Room) con Laravel 11 y Supabase PostgreSQL 15+",
  "keywords": [
    "laravel",
    "accounting",
    "erp",
    "supabase",
    "multi-tenant",
    "rls"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "ext-bcmath": "*",
    "ext-pdo_pgsql": "*",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "audit": {
      "block-on": false
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
