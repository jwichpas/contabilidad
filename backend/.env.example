# Plantilla de desarrollo local. Neon es el proveedor activo en este ejemplo.
# Supabase permanece documentado al final como referencia sin activarse.
# Credenciales y cadenas de conexion completas solo en backend/.env privado.

APP_NAME="ERP Contable"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==============================================================================
# SUNAT TC USD/PEN — sincronización controlada (NO se activa automáticamente)
# ==============================================================================
# El backend puede importar bajo demanda el TXT oficial si fecha publicada = fecha solicitada.
# El scheduler usa Laravel y solo el rol app_backend, con contexto de empresa RLS.
# Activar únicamente después de verificar empresas y habilitar un schedule runner.
ACCOUNTING_SUNAT_FX_SCHEDULE_ENABLED=false
# IDs de compañías autorizadas, separadas por coma (vacío = ninguna)
ACCOUNTING_SUNAT_FX_COMPANY_IDS=
# El TXT oficial contiene SOLO el TC publicado actualmente, no un histórico.
# URL fija en código: https://www.sunat.gob.pe/a/txt/tipoCambio.txt
# Cron Laravel al estar activado: 10:30 y 16:30, hora America/Lima.

# Laravel 13 puede usar caché en PostgreSQL por defecto.
# Nuestro esquema no incluye tablas cache/cache_locks; para limitar intentos
# de login ('throttle:10,1') usar caché persistente de archivos localmente.
# Producción multi-instancia: usar Redis y configurar CACHE_STORE=redis.
CACHE_STORE=file

# ==============================================================================
# ERP CONTABLE | DESARROLLO / PRUEBAS CON NEON POSTGRESQL
# ==============================================================================
# Backend PHP 8.5 + Laravel 13; PostgreSQL 18 es el motor OBJETIVO del ERP.
# Neon sera el entorno remoto de pruebas; Supabase queda conservado abajo,
# solo como referencia/alternativa. NO se eliminan proyectos ni datos.
#
# Conexion Neon: rama contabilidad-dev ya creada; base neondb; propietario neondb_owner.
# La rama original production permanece intacta; NO USAR su endpoint.
# Se creo la rama aislada contabilidad-dev para pruebas del ERP.
# en Neon. Comprobar host, rama y motor PostgreSQL en Neon Connect.
#
# No subir backend/.env ni contrasenas. No copiar un URL con secretos en Git.
# Cambiar SOLO valores en backend/.env privado.
# Identidad DECLARADA de la rama de pruebas: copiar host DIRECTO desde
# Neon > Branches > crear una rama, p. ej. contabilidad-dev, y Connect.
# OJO: estas variables no comprueban por si solas el nombre remoto de rama;
# el preflight compara endpoints y bloquea el host production de la captura.
NEON_TEST_BRANCH_NAME=contabilidad-dev
NEON_TEST_BRANCH_HOST=ep-sweet-king-b6hxra2r.c-2.sa-east-1.aws.neon.tech
#
# NEON_APP (DIRECTA por ahora: pooling desactivado en el compute Neon)
# Endpoint DIRECTO de la rama contabilidad-dev. No usar -pooler hasta habilitarlo en Neon.
# app_backend NO existe aun en contabilidad-dev: crear desde migracion inicial segura.
# Crear primero el rol y permisos RLS en Neon de manera controlada.
# NUNCA usar neondb_owner para peticiones de usuarios multiempresa.
# No mezclar DB_URL/DATABASE_URL con DB_HOST/...; la URL prevalece.
# Usar variables separadas evita contrasenas reservadas sin URL encoding.
DB_CONNECTION=pgsql
DB_URL=
DATABASE_URL=
DB_HOST=ep-sweet-king-b6hxra2r.c-2.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=app_backend
DB_PASSWORD=
DB_SSLMODE=require
# Con conexion DIRECTA no hace falta emular prepared statements nativos.
NEON_USE_POOLING=false
DB_EMULATE_PREPARES=false

# NEON_ADMIN (CONEXION DIRECTA, migraciones Laravel y DDL)
# En Neon, desactivar "Connection pooling" en Connect para obtener host directo.
# El host directo NO lleva el sufijo -pooler; confirmar en el panel.
# Pooling desactivado en contabilidad-dev (Neon API al 21/10/2026). Ambos hosts son directos.
# Para habilitar PgBouncer en otro momento, usar DB_HOST con -pooler y DB_EMULATE_PREPARES=true.
# No usar puerto 6543 de Supavisor: Neon utiliza 5432.
# DB_MIGRATIONS_URL debe quedar VACIO si se usan campos independientes.
# Si optas por una URI de Neon, separar parametros con &:
#   ?sslmode=require&channel_binding=require
# No colocar channel_binding=require dentro de DB_MIGRATIONS_SSLMODE.
DB_MIGRATIONS_URL=
DB_MIGRATIONS_HOST=ep-sweet-king-b6hxra2r.c-2.sa-east-1.aws.neon.tech
DB_MIGRATIONS_PORT=5432
DB_MIGRATIONS_DATABASE=neondb
DB_MIGRATIONS_USERNAME=neondb_owner
DB_MIGRATIONS_PASSWORD=
DB_MIGRATIONS_SSLMODE=require

# Credenciales de roles restringidos: solo si se crean en Neon para el ERP.
# No inventar ni reutilizar contrasenas ni usar estos ejemplos en produccion.
DB_APP_BACKEND_ROLE_PASSWORD=
DB_APP_BACKEND_NEW_PASSWORD=

# NOTA DE SEGURIDAD PARA LAS MIGRACIONES:
# Las migraciones antiguas con controles de ID Supabase NO aplican a Neon.
# No ejecutar php artisan migrate (general) ni migrate:fresh sobre Neon.
# Preparar primero bootstrap de roles/RLS y compatibilidad de migraciones
# para Neon, probar en Docker y verificar la rama/base remota de destino.
# Preflight Neon (sin SQL por defecto): php scripts/phase1-neon-preflight.php
# Verificacion SELECT opcional: php scripts/phase1-neon-preflight.php --read-only
# Ningun preflight habilita automaticamente migraciones remotas.

# ==============================================================================
# REFERENCIA CONSERVADA: SUPABASE DEV (INACTIVA EN ESTA PLANTILLA)
# ==============================================================================
# Variables de configuracion originales conservadas como comentarios.
# Para volver a Supabase, elegir solo una configuracion activa.
# ==============================================================================
# CASO 1 (SOLO DEV): TRÁFICO DE APLICACIÓN VÍA SUPAVISOR
# Modo Transacción (Puerto 6543) usando el rol restringido `app_backend` (con RLS)
# ==============================================================================
# DB_CONNECTION=pgsql
# DB_HOST=aws-1-ca-central-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# Rol restringido de Laravel, sin BYPASSRLS. Validar el formato de usuario en Connect de Supabase.
# DB_USERNAME=app_backend.bnjwxphwtkhblvhsnylj
# DB_PASSWORD=
# DB_SSLMODE=require
# En modo transacción (puerto 6543) DEBE ser true para deshabilitar prepared statements nativos.
# Si usas Supavisor en Modo Sesión (puerto 5432), puedes cambiar DB_PORT=5432 y DB_EMULATE_PREPARES=false.
# DB_EMULATE_PREPARES=true
# Si se utiliza DATABASE_URL, prevalece sobre DB_HOST/DB_USERNAME/DB_PORT.
# No copiar aquí un URL administrativo ni una URI con password real.
# DATABASE_URL=
# 
# ==============================================================================
# CASO 2 (SOLO DEV): CONEXIÓN ADMINISTRATIVA PARA MIGRACIONES DDL
# Puerto 5432 usando el rol propietario `postgres` (sin limitaciones de pooler transaccional)
# ==============================================================================
# Dejar la URI vacia si se usan HOST/PORT/USERNAME/PASSWORD por separado.
# Una URI defectuosa puede provocar invalid sslmode value: connect_timeout=30.
# DB_MIGRATIONS_URL=
# DB_MIGRATIONS_HOST=db.bnjwxphwtkhblvhsnylj.supabase.co
# DB_MIGRATIONS_PORT=5432
# DB_MIGRATIONS_DATABASE=postgres
# DB_MIGRATIONS_USERNAME=postgres
# DB_MIGRATIONS_PASSWORD=
# DB_MIGRATIONS_SSLMODE=require
# 
# La contraseña de app_backend no debe tener un valor predecible; proveerla mediante
# variables de entorno y rotar cualquier credencial anteriormente publicada.
# La conexión pgsql_migrations es exclusiva para migraciones Artisan.
# DB_APP_BACKEND_ROLE_PASSWORD=cambiar_en_entorno_seguro
# 
# Rotacion de clave para rol ya existente: obligatorio solo al ejecutar la migracion
# 2026_10_20_000000_rotate_app_backend_credential; quitar tras terminar.
# Esta clave NUEVA debe coincidir con DB_PASSWORD de la conexion pgsql.
# DB_APP_BACKEND_NEW_PASSWORD=
