APP_NAME="ERP Contable"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

# En desarrollo Laravel 11 puede usar caché en PostgreSQL por defecto.
# Nuestro esquema no incluye tablas cache/cache_locks; para limitar intentos
# de login ('throttle:10,1') usar caché persistente de archivos localmente.
# Producción multi-instancia: usar Redis y configurar CACHE_STORE=redis.
CACHE_STORE=file

# ==============================================================================
# CASO 1 (RECOMENDADO EN PRODUCCIÓN): TRÁFICO DE APLICACIÓN VÍA SUPAVISOR
# Modo Transacción (Puerto 6543) usando el rol restringido `app_backend` (con RLS)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=aws-1-ca-central-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
# Rol restringido de Laravel, sin BYPASSRLS. Validar el formato de usuario en Connect de Supabase.
DB_USERNAME=app_backend.bnjwxphwtkhblvhsnylj
DB_PASSWORD=
DB_SSLMODE=require
# En modo transacción (puerto 6543) DEBE ser true para deshabilitar prepared statements nativos.
# Si usas Supavisor en Modo Sesión (puerto 5432), puedes cambiar DB_PORT=5432 y DB_EMULATE_PREPARES=false.
DB_EMULATE_PREPARES=true
# Si se utiliza DATABASE_URL, prevalece sobre DB_HOST/DB_USERNAME/DB_PORT.
# No copiar aquí un URL administrativo ni una URI con password real.
# DATABASE_URL=

# ==============================================================================
# CASO 2: CONEXIÓN DIRECTA O MODO SESIÓN PARA MIGRACIONES Y TAREAS DDL
# Puerto 5432 usando el rol propietario `postgres` (sin limitaciones de pooler transaccional)
# ==============================================================================
DB_MIGRATIONS_HOST=db.bnjwxphwtkhblvhsnylj.supabase.co
DB_MIGRATIONS_PORT=5432
DB_MIGRATIONS_DATABASE=postgres
DB_MIGRATIONS_USERNAME=postgres
DB_MIGRATIONS_PASSWORD=
DB_MIGRATIONS_SSLMODE=require

# La contraseña de app_backend no debe tener un valor predecible; proveerla mediante
# variables de entorno y rotar cualquier credencial anteriormente publicada.
# La conexión pgsql_migrations es exclusiva para migraciones Artisan.
DB_APP_BACKEND_ROLE_PASSWORD=cambiar_en_entorno_seguro

# Rotacion de clave para rol ya existente: obligatorio solo al ejecutar la migracion
# 2026_10_20_000000_rotate_app_backend_credential; quitar tras terminar.
# Esta clave NUEVA debe coincidir con DB_PASSWORD de la conexion pgsql.
DB_APP_BACKEND_NEW_PASSWORD=
