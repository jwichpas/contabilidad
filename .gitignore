# ==============================================================================
# Git Ignore - ERP Contabilidad (Laravel 11 + Vue 3 / Vite)
# ==============================================================================

# Variables de entorno y secretos
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo
frontend/*.tsbuildinfo
.pnpm-store/
.pnpm-debug.log*
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PHP / Composer / Laravel
vendor/
backend/vendor/
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# Sistema y Editores
.DS_Store
Thumbs.db
*.bak
*.tmp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
